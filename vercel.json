{
  "installCommand": "npm install && cd finance_frontend && npm install",
  "buildCommand": "cd finance_frontend && npm run build",
  "outputDirectory": "finance_frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
